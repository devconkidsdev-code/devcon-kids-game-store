# OPENROUTER_API_KEY: Required for AI-Powered Trip Planner via OpenRouter.
# AI Studio injects this from user secrets or environment variables.
# Models supported: google/gemini-2.5-flash, openai/gpt-4o-mini, anthropic/claude-3.5-haiku, etc.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# GEMINI_API_KEY: Optional fallback for server-side AI processing.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

